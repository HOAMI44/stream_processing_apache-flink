      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS \"time\", station || ' ' || window_size AS metric, avg_temp_c AS value\nFROM uc01_temperature_stats\nORDER BY window_start"
        }
      ]
